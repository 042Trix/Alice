# tests/test_instance_leak_check.py
import subprocess
import tempfile
from pathlib import Path

SCRIPT = Path(__file__).parent.parent / "check_instance_leaks.py"

def test_clean_repo_passes(tmp_path):
    """A repo with only Alice framework content passes."""
    (tmp_path / "methodology").mkdir()
    (tmp_path / "methodology" / "00-decide-ticket-naming.md").write_text(
        "---\nid: alice-methodology-00-decide-ticket-naming\n"
        "title: Methodology 00 — Decide ticket naming\ntype: methodology\n"
        "source: alice-framework\ntags: [kind:methodology, project:alice]\n"
        "---\n\n# Ticket naming\n"
    )
    result = subprocess.run(["python3", str(SCRIPT), str(tmp_path)], capture_output=True)
    assert result.returncode == 0, f"Expected 0, got {result.returncode}\n{result.stdout.decode()}"

def test_m_decide_with_instance_intent_fails(tmp_path):
    """An M-decide file with an instance intent in frontmatter is an ERROR."""
    (tmp_path / "methodology").mkdir()
    (tmp_path / "methodology" / "M-decide-x-flow.md").write_text(
        "---\nid: alice-methodology-M-decide-x-flow\ntitle: M-decide x\n"
        "type: methodology\nsource: alice-framework\n"
        "intent: ~/.hermes/loops/intents/x-flow-intent.md\n"
        "tags: [kind:methodology, project:alice]\n---\n\n# x flow\n"
    )
    result = subprocess.run(["python3", str(SCRIPT), str(tmp_path)], capture_output=True)
    assert result.returncode == 1
    assert "H1" in result.stdout.decode()

def test_hermes_path_in_body_fails(tmp_path):
    """A body that references ~/.hermes/profiles/ is an ERROR."""
    (tmp_path / "methodology").mkdir()
    (tmp_path / "methodology" / "00-decide-test.md").write_text(
        "---\nid: test\ntitle: test\ntype: methodology\nsource: alice-framework\n"
        "tags: [kind:methodology, project:alice]\n---\n\n"
        "The jarvis profile lives at ~/.hermes/profiles/jarvis/SOUL.md\n"
    )
    result = subprocess.run(["python3", str(SCRIPT), str(tmp_path)], capture_output=True)
    assert result.returncode == 1
    assert "H2" in result.stdout.decode()

def test_bak_file_fails(tmp_path):
    """A .bak file is an ERROR (X1)."""
    (tmp_path / "CHANGELOG.md.bak").write_text("backup\n")
    result = subprocess.run(["python3", str(SCRIPT), str(tmp_path)], capture_output=True)
    assert result.returncode == 1
    assert "X1" in result.stdout.decode()

def test_profile_name_warning(tmp_path):
    """3+ Hermes profile names in body is a WARNING."""
    (tmp_path / "methodology").mkdir()
    (tmp_path / "methodology" / "00-decide-test.md").write_text(
        "---\nid: test\ntitle: test\ntype: methodology\nsource: alice-framework\n"
        "tags: [kind:methodology, project:alice]\n---\n\n"
        "jarvis, coder, planner, verifier all do this.\n"
    )
    result = subprocess.run(["python3", str(SCRIPT), str(tmp_path)], capture_output=True)
    # Default: warnings don't block; exit 0
    assert result.returncode == 0
    # With --strict-warnings: exit 1
    result_strict = subprocess.run(
        ["python3", str(SCRIPT), str(tmp_path), "--strict-warnings"],
        capture_output=True,
    )
    assert result_strict.returncode == 1
    assert "H3" in result_strict.stdout.decode()
```

